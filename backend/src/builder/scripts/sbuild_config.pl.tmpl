# Auto-generated sbuild config for rebuild experiments.
# Loaded via SBUILD_CONFIG after user config; all values here win.

$build_environment = {
    __ENV_BLOCK__
};

$external_commands = {
    'build-failed-commands' => [],
    'build-deps-failed-commands' => [],
    'chroot-update-failed-commands' => [],
    'anything-failed-commands' => [],
};

$purge_build_directory = 'always';
$purge_session = 'always';
$purge_build_deps = '__PURGE_BUILD_DEPS__';

$run_lintian = 0;
$clean_source = 0;

# mmdebstrap defaults to archive.ubuntu.com on https with main-only sources.
# Pass full deb lines instead of a bare mirror: main+universe (build-deps of
# main packages can live in universe, e.g. texinfo) across all three pockets,
# matching a real Ubuntu buildd. Key is matched against the distribution
# string; each deb line becomes one sources.list entry verbatim.
$unshare_mmdebstrap_extra_args = [
    '__DIST__' => [
        'deb __MIRROR__ __DIST__ main universe',
        'deb __MIRROR__ __DIST__-updates main universe',
        'deb __MIRROR__ __DIST__-security main universe',
    ]
];

# Without this sbuild re-runs mmdebstrap for every single build (~40s each).
$unshare_mmdebstrap_keep_tarball = 1;

1;
